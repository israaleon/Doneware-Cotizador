# Copia este archivo como ".env.local" (sin ".example") en la raíz de tu proyecto Next.js.

# --- Públicas (van también en el navegador) ---
# Project Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- Privadas (SOLO servidor — nunca deben llevar el prefijo NEXT_PUBLIC_) ---
# Project Settings → API → service_role key (¡mantenla secreta! salta toda la
# seguridad por fila de tu base de datos). La usan /api/ml-lookup y el cron
# diario de precios, que no tienen ningún usuario con sesión iniciada.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Cualquier cadena larga y aleatoria que tú inventes (ej. genera una en
# https://1password.com/password-generator/). Protege que solo Vercel pueda
# disparar el cron diario que revisa precios — nadie más debería poder
# llamar a esa ruta.
CRON_SECRET=inventa-una-cadena-larga-y-aleatoria-aqui

# Recuerda agregar estas mismas 3 variables en Vercel → tu proyecto →
# Settings → Environment Variables cuando despliegues.
